          "10908"
        ],
        "ScenarioInfoFinishConversationList": [
          "<T t=\"哎呀，你虽有慧根，打得却毫无章法，看来门派武功还尚未入门，实在不符合我的美学！\"></T>",
          "<T t=\"这套太祖长拳\" c=\"ffffff33\" ></T><T t=\"就传授于你，你先参悟一下吧！\"></T>"
        ],
        "ScenarioInfoFinishNpcID": [
          "10908",
