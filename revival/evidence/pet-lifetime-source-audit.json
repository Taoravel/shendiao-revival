      {
        "attributes": {
          "id": "36001",
          "answer": "<T t=\"【宠物寿命】\" c=\"ffff3333\"></T><B></B>\n<T t=\"名词解释\" c=\"ff00ffff\"></T><T t=\"：\"></T><B></B>\n<T t=\"1、每只宠物都有一定的寿命，当宠物寿命低于50点时，宠物可以设为参战状态，但不会参加战斗。\"></T><B></B>\n<T t=\"2、宠物寿命会受到\"></T><G t=\"宠物颜色\" m=\"1\" c=\"ffffff33\" npcid=\"36026\"></G><T t=\"的影响。\"></T><B></B>\n<T t=\"3、宠物只要参加一场战斗就会消耗一点寿命，宠物死亡一次会消耗50点寿命。\"></T><B></B>\n<T t=\"4、宠物的寿命可以通过使用\"></T><G t=\"岁寒三友\" m=\"1\" c=\"ffffff33\" npcid=\"10004\"></G><T t=\"、\"></T><G t=\"荷叶羹\" m=\"1\" c=\"ffffff33\" npcid=\"10007\"></G><T t=\"、\"></T><G t=\"蟹黄汤包\" m=\"1\" c=\"ffffff33\" npcid=\"10009\"></G><T t=\"来恢复。\"></T>"
        },
        "lists": {}
      },
