        "ScenarioInfoNpcConversationList": [
          "老板，住店。",
          "<T t=\"没有啦！没有啦，什么都没啦！……啊？有客来了，唉，实在不好意思客官，\"></T><T t=\"本店今天不营业了。\" c=\"ffffff33\" ></T>",
          "<T t=\"嗯？你问为什么，前几日店里新来个伙计，我看他做事挺灵活的，就让他帮忙收拾下账房，结果\" ></T><T t=\"这小子居然把账房的银子都给卷走啦！\" c=\"ffffff33\" ></T>",
          "<T t=\"现在店里也没钱请不起帮工，我这就要准备关门了呢……唉，我错了，我当初就不该来这个地方，如果我不来这个地方我的夫君也……\"></T>",
          "<T t=\"好啦好啦，老板我明白了，你可知那伙计现在何处？我去帮你把银子追回来。\"></T>"
        ],
        "ScenarioInfoNpcID": [
          "1",
          "10157",
          "10157",
          "10157",
          "1"
        ],
        "ScenarioInfoFinishConversationList": [
          "<T t=\"额的神啊，当真！？听说有人看到他在雷峰塔附近露过面，那地方不太平，少侠你一个人去要小心啊。\"></T>"
        ],
        "ScenarioInfoFinishNpcID": [
          "10157"
        ]
      }
