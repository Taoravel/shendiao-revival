    "children": []
  },
  {
    "attributes": {
      "id": "2",
      "taskname": "敌后奇兵",
      "tasklevel": "50级以上",
      "tasktext": "<T t=\"【限制时间：2小时】\" c=\"ffffff33\"></T><B></B><T t=\"前一段时间，兵部曾经派出一支侦察兵队深入荒漠探查蛮兵动向，可是这么长的时间音讯全无，兵部本来以为全队人都已经遭受不测，便已认定他们都已牺牲。可谁知日前江湖人士鲍仁传来消息，之前在雁门关失踪的侦查小队还有幸存者，现在不幸被敌军俘虏。\" c=\"ffffff33\"></T><B></B><T t=\"兵部决定派遣一支敌后奇兵，不惜一切代价去救回幸存者。还望有志之士汇聚一处，共同前往。\" c=\"ffffff33\"></T>",
      "taskready": "1",
      "taskicon": "1466",
