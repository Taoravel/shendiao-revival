      <Window Type="TaharezLook/CommonCaseSimple" Name="MyTeam/team/text">
        <Property Name="UnifiedAreaRect" Value="{{0.0116279,0},{0.639423,0},{0.95814,0},{0.920673,0}}" />
        <Window Type="TaharezLook/StaticText" Name="MyTeam/team/text/t1">
          <Property Name="Font" Value="fzy4k-11" />
          <Property Name="Text" Value="战队规则" />
          <Property Name="HorzExtent" Value="60" />
          <Property Name="VertExtent" Value="17.1936" />
          <Property Name="TextColours" Value="tl:FFFFDE00 tr:FFFFDE00 bl:FFFFA405 br:FFFFA405" />
