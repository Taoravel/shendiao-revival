          </Window>
          <Window Type="TaharezLook/RadioButton" Name="GroupSettingManager/Tab/Tab 3/DelRole">
            <Property Name="Text" Value="驱逐出群的玩家ID" />
            <Property Name="UnifiedAreaRect" Value="{{0,14.0617},{0,39},{0,154.062},{0,59}}" />
          </Window>
          <Window Type="TaharezLook/Editbox" Name="GroupSettingManager/Tab/Tab 3/DelRoleIDEdit">
            <Property Name="BlinkCaret" Value="True" />
            <Property Name="MaxTextLength" Value="2147483647" />
            <Property Name="UnifiedAreaRect" Value="{{0,156},{0,39},{0,280},{0,59}}" />
            <Property Name="TextParsingEnabled" Value="False" />
          </Window>
          <Window Type="TaharezLook/RadioButton" Name="GroupSettingManager/Tab/Tab 3/NewManagerRole">
            <Property Name="Text" Value="定为管理员的玩家ID" />
            <Property Name="UnifiedAreaRect" Value="{{0,14.0617},{0,66},{0,154.062},{0,86}}" />
          </Window>
          <Window Type="TaharezLook/Editbox" Name="GroupSettingManager/Tab/Tab 3/NewManagerIDEdit">
            <Property Name="BlinkCaret" Value="True" />
            <Property Name="MaxTextLength" Value="2147483647" />
            <Property Name="UnifiedAreaRect" Value="{{0,156},{0,66},{0,280},{0,86}}" />
            <Property Name="TextParsingEnabled" Value="False" />
          </Window>
          <Window Type="TaharezLook/RadioButton" Name="GroupSettingManager/Tab/Tab 3/CancelManager">
            <Property Name="Text" Value="取消管理员的玩家ID" />
            <Property Name="UnifiedAreaRect" Value="{{0,14.0617},{0,93},{0,154.062},{0,113}}" />
          </Window>
          <Window Type="TaharezLook/Editbox" Name="GroupSettingManager/Tab/Tab 3/CancelManagerEdit">
