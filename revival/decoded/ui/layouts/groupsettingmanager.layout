            <Property Name="MaxTextLength" Value="2147483647" />
            <Property Name="UnifiedAreaRect" Value="{{0,156},{0,93},{0,280},{0,113}}" />
            <Property Name="TextParsingEnabled" Value="False" />
          </Window>
        </Window>
      </Window>
    </Window>
    <Window Type="TaharezLook/Button" Name="GroupSettingManager/OkBtn">
