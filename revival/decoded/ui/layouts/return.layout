      <Property Name="HorzFormatting" Value="WordWrapLeftAligned" />
      <Property Name="VertFormatting" Value="TopAligned" />
      <Property Name="UnifiedAreaRect" Value="{{0.05,49},{0.465934,0},{0.761363,44},{0.569231,0}}" />
      <Property Name="BackgroundEnabled" Value="False" />
    </Window>
    <Window Type="TaharezLook/StaticText" Name="Return/Top1">
      <Property Name="Font" Value="simhei-12" />
      <Property Name="Text">君子剑与淑女剑经由神雕侠侣交付你手，江湖重任，家国大义都由你担当。双剑合璧，天下睥睨。以飞虹之石锻造，以鎏金之锤重铸，以千古名剑之魂凝集，激发无上的剑意！

                                                                                                                                  </Property>
      <Property Name="HorzExtent" Value="306" />
      <Property Name="VertExtent" Value="93.7134" />
      <Property Name="TextColours" Value="tl:FF6EE6FF tr:FF6EE6FF bl:FF6EE6FF br:FF6EE6FF" />
      <Property Name="BorderColour" Value="FF003454" />
