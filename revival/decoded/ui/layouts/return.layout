    <Window Type="TaharezLook/StaticText" Name="Return/Top">
      <Property Name="Font" Value="simhei-12" />
      <Property Name="Text" Value="大战金轮是无数神雕豪侠的梦想，而金轮此次大举来袭，率千万精兵，粮草与精锐并行，势将攻下襄阳。如此为难之际，怎可临阵脱逃，浴血奋战吧！" />
      <Property Name="HorzExtent" Value="300" />
      <Property Name="VertExtent" Value="46.8567" />
      <Property Name="TextColours" Value="tl:FF6EE6FF tr:FF6EE6FF bl:FF6EE6FF br:FF6EE6FF" />
      <Property Name="BorderColour" Value="FF003454" />
      <Property Name="BorderEnable" Value="True" />
