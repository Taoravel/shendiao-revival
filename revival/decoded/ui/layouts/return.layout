      <Property Name="UnifiedAreaRect" Value="{{0.05,49},{0.338462,-41},{0.761363,44},{0.338462,24}}" />
      <Property Name="BackgroundEnabled" Value="False" />
      <Window Type="TaharezLook/StaticText" Name="Return/Main2">
        <Property Name="Text" Value="华山之巅    新地图、新宠物" />
        <Property Name="HorzExtent" Value="103" />
        <Property Name="VertExtent" Value="31.2378" />
        <Property Name="TextColours" Value="tl:FF35F608 tr:FF35F608 bl:FF35F608 br:FF35F608" />
