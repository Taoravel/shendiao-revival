            <Property Name="DefaultColourEnable" Value="True" />
          </Window>
          <Window Type="TaharezLook/StaticText" Name="CofCIntro/startmoney">
            <Property Name="Font" Value="simhei-12" />
            <Property Name="Text" Value="建店费用" />
            <Property Name="HorzExtent" Value="52" />
            <Property Name="VertExtent" Value="15.6189" />
            <Property Name="TextColours" Value="tl:FFFFFF00 tr:FFFFFF00 bl:FFFF6E02 br:FFFF6E02" />
            <Property Name="BorderColour" Value="FF003454" />
            <Property Name="FrameEnabled" Value="False" />
            <Property Name="UnifiedAreaRect" Value="{{0,9},{0,29},{0,84},{0,49}}" />
            <Property Name="BackgroundEnabled" Value="False" />
          </Window>
          <Window Type="TaharezLook/StaticText" Name="CofCIntro/1">
            <Property Name="Text">开店时要支付的建造费用和基本运营资金各240000*商业指数，另外，这一

切费用还需要缴纳3%的投资税，也就是说，一共是                         两。</Property>
            <Property Name="HorzExtent" Value="433" />
            <Property Name="VertExtent" Value="31.2378" />
            <Property Name="TextColours" Value="tl:FF6EE6FF tr:FF6EE6FF bl:FF6EE6FF br:FF6EE6FF" />
            <Property Name="BorderColour" Value="FF003454" />
            <Property Name="FrameEnabled" Value="False" />
            <Property Name="UnifiedAreaRect" Value="{{0,9},{0,50},{0,441},{0,88}}" />
            <Property Name="BackgroundEnabled" Value="False" />
            <Property Name="DefaultBorderEnable" Value="True" />
            <Property Name="DefaultColourEnable" Value="True" />
          </Window>
          <Window Type="TaharezLook/StaticText" Name="CofCIntro/preserve">
            <Property Name="Text" Value="维护费用" />
            <Property Name="HorzExtent" Value="52" />
            <Property Name="VertExtent" Value="15.6189" />
            <Property Name="TextColours" Value="tl:FFFFFF00 tr:FFFFFF00 bl:FFFF6E02 br:FFFF6E02" />
            <Property Name="BorderColour" Value="FF003454" />
            <Property Name="FrameEnabled" Value="False" />
            <Property Name="UnifiedAreaRect" Value="{{0,9},{0,89},{0,124},{0,109}}" />
            <Property Name="BackgroundEnabled" Value="False" />
          </Window>
