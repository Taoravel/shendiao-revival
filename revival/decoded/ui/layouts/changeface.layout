<?xml version='1.0' encoding='utf-8'?>
<GUILayout>
  <Window Type="DefaultWindow" Name="ChangeFace">
    <Property Name="EnableSound" Value="True" />
    <Property Name="SoundResource" Value="ciqi.ogg" />
    <Property Name="UnifiedAreaRect" Value="{{0,204},{0,229},{0,704},{0,425}}" />
    <Property Name="CloseSoundResource" Value="npcdlg.ogg" />
    <Window Type="TaharezLook/StaticImage" Name="ChangeFace/icon">
      <Property Name="Image" Value="set:RoleAndMonster23 image:9094" />
