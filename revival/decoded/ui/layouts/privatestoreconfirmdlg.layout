<?xml version='1.0' encoding='utf-8'?>
<GUILayout>
  <Window Type="TaharezLook/StaticImage" Name="PrivateStoreConfirmDlg">
    <Property Name="Font" Value="simhei-12" />
    <Property Name="Image" Value="set:MainControl5 image:TipBox" />
    <Property Name="AlwaysOnTop" Value="True" />
    <Property Name="FrameEnabled" Value="False" />
    <Property Name="UnifiedAreaRect" Value="{{0.351875,0},{0.3775,0},{0.351875,237},{0.3775,147}}" />
    <Property Name="BackgroundEnabled" Value="False" />
    <Window Type="TaharezLook/StaticText" Name="PrivateStoreConfirmDlg/TextBox1">
      <Property Name="Font" Value="simhei-12" />
      <Property Name="Text">摆摊需要支付1000两摊位费以及5点
活力，卖出物品会收取5%的交易税，
确定继续吗?</Property>
      <Property Name="HorzExtent" Value="218" />
      <Property Name="VertExtent" Value="46.8567" />
      <Property Name="TextColours" Value="tl:FFFFFFFF tr:FFFFFFFF bl:FFFFFFFF br:FFFFFFFF" />
      <Property Name="BorderColour" Value="FF003454" />
      <Property Name="FrameEnabled" Value="False" />
      <Property Name="HorzFormatting" Value="WordWrapLeftAligned" />
      <Property Name="UnifiedAreaRect" Value="{{0,14},{0,15},{0,232},{0,74}}" />
      <Property Name="BackgroundEnabled" Value="False" />
    </Window>
    <Window Type="TaharezLook/StaticText" Name="PrivateStoreConfirmDlg/TextBox2">
      <Property Name="Font" Value="simhei-12" />
      <Property Name="Text">收摊后10分钟内再次摆摊可免收摊位
费以及活力</Property>
      <Property Name="HorzExtent" Value="211" />
      <Property Name="VertExtent" Value="31.2378" />
      <Property Name="TextColours" Value="tl:FFFFFF00 tr:FFFFFF00 bl:FFFFFF00 br:FFFFFF00" />
      <Property Name="BorderColour" Value="FF003454" />
      <Property Name="FrameEnabled" Value="False" />
      <Property Name="UnifiedAreaRect" Value="{{0,14},{0,70},{-0.0466456,243.275},{0,106}}" />
      <Property Name="BackgroundEnabled" Value="False" />
    </Window>
    <Window Type="TaharezLook/Button" Name="PrivateStoreConfirmDlg/OK">
      <Property Name="Font" Value="simhei-12" />
      <Property Name="Text" Value="确   定" />
      <Property Name="SizeType" Value="Auto" />
      <Property Name="UnifiedAreaRect" Value="{{0,47},{0,110},{0,115},{0,134}}" />
    </Window>
    <Window Type="TaharezLook/Button" Name="PrivateStoreConfirmDlg/Cancel">
      <Property Name="Font" Value="simhei-12" />
      <Property Name="Text" Value="取   消" />
      <Property Name="SizeType" Value="Auto" />
      <Property Name="UnifiedAreaRect" Value="{{0,125},{0,110},{0,193},{0,134}}" />
    </Window>
  </Window>
</GUILayout>