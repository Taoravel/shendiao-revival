<?xml version='1.0' encoding='utf-8'?>
<GUILayout>
  <Window Type="TaharezLook/ChatBack" Name="ChatOutput/ChatOutputBox/Back">
    <Property Name="UnifiedAreaRect" Value="{{0,-5},{1,-204},{0,305},{1,-72}}" />
    <Property Name="DisplaySizeChangePosEnabled" Value="False" />
    <Window Type="TaharezLook/LeftVertScrollRichEditbox" Name="ChatOutput/ChatOutputBox">
      <Property Name="Font" Value="simhei-12" />
      <Property Name="ReadOnly" Value="True" />
      <Property Name="LineSpace" Value="1" />
      <Property Name="BlinkCaret" Value="True" />
      <Property Name="MaxTextLength" Value="1073741823" />
