  <Window Type="TaharezLook/FrameWindow" Name="ShijieBossTips">
    <Property Name="Text" Value="玩法说明" />
    <Property Name="EnableSound" Value="True" />
    <Property Name="RollUpEnabled" Value="True" />
    <Property Name="SizingEnabled" Value="False" />
    <Property Name="SoundResource" Value="dlgopen.mp3" />
