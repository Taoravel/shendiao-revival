      <Window Type="TaharezLook/CommonCaseFigure1" Name="GangMoneySetAuto/Back/Bot">
        <Property Name="UnifiedAreaRect" Value="{{0,4},{0.335052,0},{0,306},{0.974227,0}}" />
        <Window Type="TaharezLook/StaticText" Name="GangMoneySetAuto/Back/Info">
          <Property Name="Text">说明：
         1、设置每次奖励银两数量为0，即为不奖励；
         2、设置好自动奖励后，帮派成员每次完成对应任务，即可立即获得该银两奖励，奖励从帮费中扣除；
         3、当帮费剩余量不足奖励时，则不再奖励。</Property>
          <Property Name="HorzExtent" Value="290" />
          <Property Name="VertExtent" Value="93.7134" />
          <Property Name="TextColours" Value="tl:FF6EE6FF tr:FF6EE6FF bl:FF6EE6FF br:FF6EE6FF" />
