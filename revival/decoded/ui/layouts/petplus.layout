        <Window Type="TaharezLook/ItemCell" Name="PetPlus/back/petback/Item">
          <Property Name="Tooltip" Value="宠物之星是通过“抽取宠物之星”的玩法获得的\n" />
          <Property Name="UnifiedAreaRect" Value="{{0.686567,0},{0,182},{0.81791,0},{0,228}}" />
        </Window>
        <Window Type="TaharezLook/StaticText" Name="PetPlus/starinfo">
          <Property Name="Text" Value="“抽取宠物之星”可获得此道具。" />
          <Property Name="HorzExtent" Value="119" />
          <Property Name="VertExtent" Value="31.2378" />
          <Property Name="TextColours" Value="tl:FFFFFFFF tr:FFFFFFFF bl:FFFFFFFF br:FFFFFFFF" />
          <Property Name="BorderColour" Value="FF003679" />
          <Property Name="FrameEnabled" Value="False" />
          <Property Name="HorzFormatting" Value="WordWrapLeftAligned" />
          <Property Name="UnifiedAreaRect" Value="{{0,191},{0,233},{0,318},{0,278}}" />
          <Property Name="BackgroundEnabled" Value="False" />
        </Window>
        <Window Type="TaharezLook/StaticImage" Name="PetPlus/back/petback/Seporater">
          <Property Name="Image" Value="set:MainControl14 image:Line" />
          <Property Name="FrameEnabled" Value="False" />
          <Property Name="UnifiedAreaRect" Value="{{0,59},{0,148},{0,305},{0,150}}" />
          <Property Name="BackgroundEnabled" Value="False" />
        </Window>
        <Window Type="TaharezLook/StaticText" Name="PetPlus/starinfo1">
          <Property Name="Text">1. "宠物之星"可以通过"抽取宠物之星"功能来获得。

2. "宠物之星"所含技能每个都有一定几率合成到主宠上。

3. 使用"宠物之星"合成时将不会掉格子，其所含技能数量越多，主宠获得新技能的几率就越大。

4. 主宠已有技能数越多，合成之后获得新技能的几率越低，"拓格"几率也越低。另外，6技能及以上的主宠，使用宠物之星将不会"拓格"。
</Property>
          <Property Name="HorzExtent" Value="326" />
          <Property Name="VertExtent" Value="109.332" />
          <Property Name="TextColours" Value="tl:FF6EE6FF tr:FF6EE6FF bl:FF6EE6FF br:FF6EE6FF" />
          <Property Name="BorderColour" Value="FF003679" />
          <Property Name="FrameEnabled" Value="False" />
          <Property Name="HorzFormatting" Value="WordWrapLeftAligned" />
          <Property Name="UnifiedAreaRect" Value="{{0.05,-12},{0.0694444,0},{0.05,314},{0.05,116}}" />
          <Property Name="BackgroundEnabled" Value="False" />
        </Window>
        <Window Type="TaharezLook/StaticText" Name="PetPlus/starinfo11">
          <Property Name="Text" Value="5. 注意！合成宠物之星可能会导致主宠已有技能被替换。" />
          <Property Name="HorzExtent" Value="327" />
          <Property Name="VertExtent" Value="15.6189" />
          <Property Name="TextColours" Value="tl:FFFF33FF tr:FFFF33FF bl:FFFF33FF br:FFFF33FF" />
          <Property Name="BorderColour" Value="FF003679" />
          <Property Name="FrameEnabled" Value="False" />
          <Property Name="HorzFormatting" Value="WordWrapLeftAligned" />
          <Property Name="UnifiedAreaRect" Value="{{0.05,-12},{0.440972,0},{0.05,317},{0.1,119}}" />
          <Property Name="BackgroundEnabled" Value="False" />
        </Window>
