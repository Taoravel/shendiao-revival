        <Property Name="HorizontalAlignment" Value="Centre" />
      </Window>
    </Window>
    <Window Type="TaharezLook/CommonCaseFigure1" Name="EvaluateMaster/Back">
      <Property Name="UnifiedAreaRect" Value="{{0,18},{0,44},{0,380},{0,189}}" />
      <Window Type="TaharezLook/StaticText" Name="EvaluateMaster/titleText">
        <Property Name="Text" Value="       恭喜你，在师父的悉心帮助下，你升级了。请对你的师父做出一个评价，请在下面选项中选择：" />
