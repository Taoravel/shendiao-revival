        <Property Name="Title" Value="True" />
        <Property Name="HorzExtent" Value="68" />
        <Property Name="VertExtent" Value="17.3281" />
        <Property Name="TextColours" Value="tl:FFFFEAA9 tr:FFFFEAA9 bl:FFFF9600 br:FFFF9600" />
        <Property Name="BorderColour" Value="FF003454" />
        <Property Name="FrameEnabled" Value="False" />
        <Property Name="HorzFormatting" Value="HorzCentred" />
        <Property Name="UnifiedAreaRect" Value="{{0,71},{0,1},{0,162},{0,24}}" />
