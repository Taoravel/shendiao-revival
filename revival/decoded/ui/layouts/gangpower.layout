<?xml version='1.0' encoding='utf-8'?>
<GUILayout>
  <Window Type="TaharezLook/FrameWindow" Name="GangPowerSetting">
    <Property Name="EnableSound" Value="True" />
    <Property Name="RollUpEnabled" Value="True" />
    <Property Name="SizingEnabled" Value="False" />
    <Property Name="TitlebarEnabled" Value="True" />
    <Property Name="UnifiedAreaRect" Value="{{0.2,0},{0.178333,0},{0.2,480},{0.178333,386}}" />
    <Window Type="TaharezLook/Button" Name="GangPowerSetting/OK">
      <Property Name="Text" Value="授予" />
