    </Window>
    <Window Type="TaharezLook/StaticImage" Name="GangPowerSetting/title">
      <Property Name="FrameEnabled" Value="False" />
      <Property Name="UnifiedMaxSize" Value="{{0,308},{0,27}}" />
      <Property Name="UnifiedMinSize" Value="{{0,308},{0,27}}" />
      <Property Name="ImageSizeEnable" Value="False" />
      <Property Name="UnifiedAreaRect" Value="{{0.728126,0},{0.0250262,0},{1.36979,0},{0.0949744,0}}" />
      <Property Name="BackgroundEnabled" Value="False" />
      <Property Name="HorizontalAlignment" Value="Centre" />
