      <Property Name="EnableSound" Value="True" />
      <Property Name="SoundResource" Value="click.ogg" />
      <Property Name="UnifiedAreaRect" Value="{{0,181.113},{0,345},{0,301.113},{0,367}}" />
    </Window>
    <Window Type="TaharezLook/Button" Name="GangPowerSetting/Cancel">
