        <Window Type="TaharezLook/StaticText" Name="PetLuckInfo/Text1112">
          <Property Name="Text" Value="8.本次活动的最终解释权归完美世界所有。" />
          <Property Name="HorzExtent" Value="245" />
          <Property Name="VertExtent" Value="15.6189" />
          <Property Name="TextColours" Value="tl:FFFFF5E2 tr:FFFFF5E2 bl:FFF2C577 br:FFF2C577" />
          <Property Name="BorderColour" Value="FF433C10" />
          <Property Name="BorderEnable" Value="True" />
          <Property Name="FrameEnabled" Value="False" />
          <Property Name="UnifiedAreaRect" Value="{{0.00408163,0},{0,266},{-0.00816326,341},{0,282}}" />
          <Property Name="BackgroundEnabled" Value="False" />
        </Window>
        <Window Type="TaharezLook/StaticText" Name="PetLuckInfo/Text111">
          <Property Name="Text" Value="7.我们将在开奖后10个工作日内为获奖角色发放奖励。" />
          <Property Name="HorzExtent" Value="313" />
          <Property Name="VertExtent" Value="15.6189" />
          <Property Name="TextColours" Value="tl:FFFFF5E2 tr:FFFFF5E2 bl:FFF2C577 br:FFF2C577" />
          <Property Name="BorderColour" Value="FF433C10" />
          <Property Name="BorderEnable" Value="True" />
          <Property Name="FrameEnabled" Value="False" />
          <Property Name="UnifiedAreaRect" Value="{{0.00408163,0},{0,245},{0,337},{0,260}}" />
          <Property Name="BackgroundEnabled" Value="False" />
        </Window>
        <Window Type="TaharezLook/StaticText" Name="PetLuckInfo/Text1111">
          <Property Name="Text">6.如本服务器共发放抽奖券16588张，212152324209除以16588余数为4517，
余数+1为4518，即4518为本服中奖号码。抽奖券编号为4518的角色将获得雕雕
神兽宠物袋，抽奖券编号为6531的角色将获得雕妹神兽宠物袋。</Property>
          <Property Name="HorzExtent" Value="461" />
          <Property Name="VertExtent" Value="46.8567" />
          <Property Name="TextColours" Value="tl:FFFFF5E2 tr:FFFFF5E2 bl:FFF2C577 br:FFF2C577" />
          <Property Name="BorderColour" Value="FF433C10" />
          <Property Name="BorderEnable" Value="True" />
          <Property Name="FrameEnabled" Value="False" />
          <Property Name="UnifiedAreaRect" Value="{{0.00408163,0},{0,194},{0,495},{0,240}}" />
          <Property Name="BackgroundEnabled" Value="False" />
        </Window>
        <Window Type="TaharezLook/StaticText" Name="PetLuckInfo/Text11">
          <Property Name="Text">5.若你获得的抽奖券编号与中奖号码完全一致，那么你将获得神兽雕雕宠物袋1个，
若你获得的抽奖卷编号为中奖号码+2013（若此数大于抽奖券总数，则为中奖号码+
2013-奖券总数），你将获得神兽雕妹宠物袋1个。</Property>
          <Property Name="HorzExtent" Value="478" />
          <Property Name="VertExtent" Value="46.8567" />
          <Property Name="TextColours" Value="tl:FFFFF5E2 tr:FFFFF5E2 bl:FFF2C577 br:FFF2C577" />
          <Property Name="BorderColour" Value="FF433C10" />
          <Property Name="BorderEnable" Value="True" />
          <Property Name="FrameEnabled" Value="False" />
          <Property Name="UnifiedAreaRect" Value="{{0.00408163,0},{0,143},{0,498},{0,189}}" />
          <Property Name="BackgroundEnabled" Value="False" />
        </Window>
        <Window Type="TaharezLook/StaticText" Name="PetLuckInfo/Text1">
          <Property Name="Text">4.用此数字整除以截止至2013年1月4日24:00时本服务器发放的抽奖券数量，
得到的余数+1即为本次活动的中奖号码。</Property>
          <Property Name="HorzExtent" Value="448" />
          <Property Name="VertExtent" Value="31.2378" />
          <Property Name="TextColours" Value="tl:FFFFF5E2 tr:FFFFF5E2 bl:FFF2C577 br:FFF2C577" />
          <Property Name="BorderColour" Value="FF433C10" />
          <Property Name="BorderEnable" Value="True" />
          <Property Name="FrameEnabled" Value="False" />
          <Property Name="UnifiedAreaRect" Value="{{0.00408163,0},{0,108},{0,467},{0,138}}" />
          <Property Name="BackgroundEnabled" Value="False" />
        </Window>
        <Window Type="TaharezLook/StaticText" Name="PetLuckInfo/Text211">
          <Property Name="Text">3.抽奖规则为，按照2012年1月6日全国福利彩票双色球第2013003期开奖信息为准，
将开奖号码6个红球号码和一个蓝球号码顺次排列组成一个数字。如开奖号码为
“02 12 15 23 24 32 +09”，则排列组成数字：2121523243209
</Property>
          <Property Name="HorzExtent" Value="490" />
          <Property Name="VertExtent" Value="46.8567" />
          <Property Name="TextColours" Value="tl:FFFFF5E2 tr:FFFFF5E2 bl:FFF2C577 br:FFF2C577" />
          <Property Name="BorderColour" Value="FF433C10" />
          <Property Name="BorderEnable" Value="True" />
          <Property Name="FrameEnabled" Value="False" />
          <Property Name="UnifiedAreaRect" Value="{{0.00408163,0},{0,57},{0,497},{0,103}}" />
          <Property Name="BackgroundEnabled" Value="False" />
        </Window>
        <Window Type="TaharezLook/StaticText" Name="PetLuckInfo/Text2">
          <Property Name="Text">2.50级以上的角色每获得300双节活动积分可领取一张神兽抽奖券，每张抽奖
券带有一个唯一编码，每角色最多领取5张抽奖券。</Property>
          <Property Name="HorzExtent" Value="442" />
          <Property Name="VertExtent" Value="31.2378" />
          <Property Name="TextColours" Value="tl:FFFFF5E2 tr:FFFFF5E2 bl:FFF2C577 br:FFF2C577" />
          <Property Name="BorderColour" Value="FF433C10" />
          <Property Name="BorderEnable" Value="True" />
          <Property Name="FrameEnabled" Value="False" />
          <Property Name="UnifiedAreaRect" Value="{{0.00408163,0},{0,23},{0,507},{0,52}}" />
          <Property Name="BackgroundEnabled" Value="False" />
        </Window>
        <Window Type="TaharezLook/StaticText" Name="PetLuckInfo/Text">
          <Property Name="Text">1.神兽抽奖活动时间为2012年12月24日8:00至2013年1月4日24:00。
</Property>
          <Property Name="HorzExtent" Value="406" />
          <Property Name="VertExtent" Value="15.6189" />
          <Property Name="TextColours" Value="tl:FFFFF5E2 tr:FFFFF5E2 bl:FFF2C577 br:FFF2C577" />
          <Property Name="BorderColour" Value="FF433C10" />
          <Property Name="BorderEnable" Value="True" />
