    <Window Type="TaharezLook/CommonCase" Name="PetSkill/Right">
      <Property Name="UnifiedAreaRect" Value="{{0.660617,0},{0,44},{0.960073,0},{0,375}}" />
      <Window Type="TaharezLook/StaticText" Name="PetSkill/Right/Info">
        <Property Name="Text">1、学习后，宠物必定学会秘籍上所携带的技能，但可能丢失原本的技能；
 
2、在学习秘籍时，宠物现有技能越多，扩格概率越低。

 
3、扩格必成进度满时，下一次学习宠物秘籍将必定扩格。
 
4、初级认证符可以保护宠物的一个技能不被顶替；高级认证符需在初级认证符的配合下使用，能保护宠物的另一个技能不被顶替。</Property>
        <Property Name="HorzExtent" Value="144" />
        <Property Name="VertExtent" Value="281.14" />
        <Property Name="TextColours" Value="tl:FF6EE6FF tr:FF6EE6FF bl:FF6EE6FF br:FF6EE6FF" />
        <Property Name="BorderColour" Value="FF003454" />
        <Property Name="FrameEnabled" Value="False" />
