<?xml version='1.0' encoding='utf-8'?>
<GUILayout>
  <Window Type="TaharezLook/ImageButton" Name="PrivateStoreNameDlg">
    <Property Name="Font" Value="fzy4k-11" />
    <Property Name="Text" Value="招牌" />
    <Property Name="Tooltip" Value="右键点击可打开摊位" />
    <Property Name="SizeType" Value="Image" />
    <Property Name="HoverImage" Value="set:MainControl image:ShopHover" />
    <Property Name="NormalImage" Value="set:MainControl image:ShopNormal" />
    <Property Name="PushedImage" Value="set:MainControl image:ShopPushed" />
    <Property Name="UnifiedMaxSize" Value="{{0,155},{0,27}}" />
    <Property Name="UnifiedMinSize" Value="{{0,155},{0,27}}" />
    <Property Name="UnifiedAreaRect" Value="{{0.05,0},{0.271667,0},{0,199},{0,190}}" />
    <Property Name="ButtonDefaultBorderEnable" Value="False" />
    <Property Name="ButtonDefaultColourEnable" Value="False" />
  </Window>
</GUILayout>