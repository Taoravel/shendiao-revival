    <Window Type="TaharezLook/CommonCaseFigure1" Name="PetRulesDlg/back">
      <Property Name="UnifiedAreaRect" Value="{{0,18},{0,44},{0,303},{0,209}}" />
      <Window Type="TaharezLook/StaticText" Name="PetRulesDlg/Text">
        <Property Name="Font" Value="simhei-12" />
        <Property Name="Text">1. 合成完毕后主宠可能学会宠物之星上的0~2个技能，也有可能因为走火入魔遗忘掉自己的1个技能。
2. 宠物之星技能个数越多或者品质（颜色）越高，主宠学会技能的概率越高。
3. 放入保护符，并选中主宠一个技能，可以保证此技能在下一次合成宠物之星时绝对不会被遗忘。
4. 放入幸运符，并选中宠物之星上记载的一个技能，可以提升主宠学会这个技能的概率。</Property>
        <Property Name="HorzExtent" Value="268" />
        <Property Name="VertExtent" Value="156.189" />
        <Property Name="TextColours" Value="tl:FF6EE6FF tr:FF6EE6FF bl:FF6EE6FF br:FF6EE6FF" />
        <Property Name="BorderColour" Value="FF003679" />
        <Property Name="BorderEnable" Value="True" />
        <Property Name="FrameEnabled" Value="False" />
        <Property Name="HorzFormatting" Value="WordWrapLeftAligned" />
        <Property Name="UnifiedAreaRect" Value="{{0.0366667,0},{0.05,-4.1},{0.05,266.902},{0.05,155.9}}" />
        <Property Name="BackgroundEnabled" Value="False" />
      </Window>
    </Window>
