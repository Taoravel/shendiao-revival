    <Window Type="TaharezLook/StaticImage" Name="MinimapDlg/SearchNpcPanel">
      <Property Name="Font" Value="simhei-12" />
      <Property Name="Image" Value="set:MainControl6 image:LeftBack" />
      <Property Name="AlwaysOnTop" Value="True" />
