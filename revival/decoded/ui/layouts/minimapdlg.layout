      </Window>
      <Window Type="TaharezLook/Checkbox" Name="MinimapDlg/Transport">
        <Property Name="Font" Value="simhei-12" />
        <Property Name="Text" Value="传送" />
        <Property Name="Selected" Value="True" />
        <Property Name="UnifiedAreaRect" Value="{{0,65},{0,5.46687},{0,105},{0,20.4669}}" />
      </Window>
      <Window Type="TaharezLook/Checkbox" Name="MinimapDlg/Business">
        <Property Name="Font" Value="simhei-12" />
        <Property Name="Text" Value="商业" />
        <Property Name="Selected" Value="True" />
        <Property Name="UnifiedAreaRect" Value="{{0,175},{0,5},{0,215},{0,20}}" />
      </Window>
      <Window Type="TaharezLook/Checkbox" Name="MinimapDlg/Normal">
        <Property Name="Font" Value="simhei-12" />
        <Property Name="Text" Value="普通" />
        <Property Name="UnifiedAreaRect" Value="{{0,120},{0,5},{0,160},{0,20}}" />
      </Window>
      <Window Type="TaharezLook/Checkbox" Name="MinimapDlg/All">
        <Property Name="Font" Value="simhei-12" />
        <Property Name="Text" Value="全部" />
        <Property Name="UnifiedAreaRect" Value="{{0,285},{0,5},{0,325},{0,20}}" />
      </Window>
      <Window Type="TaharezLook/Button" Name="MinimapDlg/WorldMap">
        <Property Name="Font" Value="simhei-12" />
        <Property Name="Text" Value="世界地图" />
        <Property Name="SizeType" Value="Auto" />
        <Property Name="ClippedByParent" Value="False" />
        <Property Name="UnifiedAreaRect" Value="{{1,-98},{0,3},{1,-10},{1,-3}}" />
      </Window>
      <Window Type="TaharezLook/Button" Name="MinimapDlg/TopPanel/NPCSearchBtn">
        <Property Name="Text" Value="NPC查询" />
        <Property Name="SizeType" Value="Auto" />
        <Property Name="EnableSound" Value="True" />
        <Property Name="SoundResource" Value="Button.ogg" />
        <Property Name="UnifiedAreaRect" Value="{{1,-289.033},{0,3},{1,-199.033},{1,-2}}" />
      </Window>
      <Window Type="TaharezLook/Checkbox" Name="MinimapDlg/task">
        <Property Name="Text" Value="任务" />
        <Property Name="Selected" Value="True" />
        <Property Name="UnifiedAreaRect" Value="{{0,230},{0,5},{0,270},{0,20}}" />
      </Window>
    </Window>
    <Window Type="TaharezLook/StaticText" Name="MinimapDlg/Title">
      <Property Name="FrameEnabled" Value="False" />
      <Property Name="HorzFormatting" Value="LeftAligned" />
      <Property Name="UnifiedMaxSize" Value="{{0,308},{0,27}}" />
