    <Property Name="UnifiedAreaRect" Value="{{0,36.0663},{0,32.9318},{0,758.066},{0,538.932}}" />
    <Property Name="CloseSoundResource" Value="close.ogg" />
    <Window Type="TaharezLook/StaticText" Name="MinimapDlg/TopPanel">
      <Property Name="Font" Value="simhei-12" />
      <Property Name="TextColours" Value="tl:FFDCF6CE tr:FFDCF6CE bl:FF10BBD3 br:FF10BBD3" />
      <Property Name="BorderColour" Value="FF003454" />
      <Property Name="UnifiedAreaRect" Value="{{0,14},{0,38},{1,-19.9835},{0,67}}" />
