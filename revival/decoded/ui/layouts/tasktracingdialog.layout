<?xml version='1.0' encoding='utf-8'?>
<GUILayout>
  <Window Type="DefaultWindow" Name="TaskTracingDialog">
    <Property Name="UnifiedAreaRect" Value="{{1,-200},{0,157},{1.0025,0},{0,316}}" />
