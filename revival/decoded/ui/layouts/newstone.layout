      <Window Type="TaharezLook/CommonCaseBlue" Name="NewStone/add/info">
        <Property Name="UnifiedAreaRect" Value="{{0.618506,0},{0.05,-16},{0.987013,0},{0.05,362}}" />
        <Window Type="TaharezLook/StaticText" Name="NewStone/add/info/txt">
          <Property Name="Text">1.镶嵌：点击带有“+”的天珠孔，再点击可镶嵌天珠，可直接镶嵌成功；                                                                                                                               2.合成并镶嵌：点击已镶嵌的天珠，再点击“合成并镶嵌”，可使用相同的四个天珠自动合成并镶嵌成功；

                                                                    3.摘除：点击已镶嵌的天珠，再点击“摘除”，可使用大明咒摘除下已镶嵌上的天珠；
                                                                    4.合成：点击最右边的“合成”标签即可打开合成页面，进行合成操
作。
</Property>
          <Property Name="HorzExtent" Value="206" />
          <Property Name="VertExtent" Value="249.902" />
