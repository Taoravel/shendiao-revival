<?xml version='1.0' encoding='utf-8'?>
<GUILayout>
  <Window Type="TaharezLook/ImageButton" Name="PristigeButton">
    <Property Name="SizeType" Value="Image" />
    <Property Name="HoverImage" Value="set:MainControl5 image:MarkHover" />
    <Property Name="NormalImage" Value="set:MainControl5 image:MarkNormal" />
    <Property Name="PushedImage" Value="set:MainControl5 image:MarkPushed" />
    <Property Name="UnifiedMaxSize" Value="{{0,40},{0,40}}" />
    <Property Name="UnifiedMinSize" Value="{{0,40},{0,40}}" />
    <Property Name="UnifiedAreaRect" Value="{{0.5,0},{0.5,-150},{0.5,0},{5,0}}" />
  </Window>
</GUILayout>