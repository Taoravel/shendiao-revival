  <WidgetLook name="TaharezLook/ShopFrameWindow">
    <PropertyDefinition name="ClientAreaColour" initialValue="FFFFFFFF" redrawOnWrite="true" />
    <PropertyLinkDefinition name="CaptionColour" widget="__auto_titlebar__" targetProperty="CaptionColour" initialValue="FFFFFFFF" />
    <NamedArea name="ClientWithTitleWithFrame">
      <Area>
        <Dim type="LeftEdge">
          <AbsoluteDim value="0" />
        </Dim>
        <Dim type="TopEdge">
          <AbsoluteDim value="0" />
        </Dim>
        <Dim type="Width">
          <UnifiedDim scale="1" type="Width" />
        </Dim>
        <Dim type="Height">
          <UnifiedDim scale="1" type="Height" />
        </Dim>
      </Area>
    </NamedArea>
    <NamedArea name="ClientWithTitleNoFrame">
      <Area>
        <Dim type="LeftEdge">
          <AbsoluteDim value="0" />
        </Dim>
        <Dim type="TopEdge">
          <WidgetDim widget="__auto_titlebar__" dimension="BottomEdge" />
        </Dim>
        <Dim type="Width">
          <UnifiedDim scale="1" type="Width" />
        </Dim>
        <Dim type="BottomEdge">
          <WidgetDim dimension="BottomEdge" />
        </Dim>
      </Area>
    </NamedArea>
    <NamedArea name="ClientNoTitleWithFrame">
      <Area>
        <Dim type="LeftEdge">
          <ImageDim imageset="component2" image="WindowTopLeft" dimension="Width" />
        </Dim>
        <Dim type="TopEdge">
          <ImageDim imageset="component2" image="WindowTopEdge" dimension="Height" />
        </Dim>
        <Dim type="RightEdge">
          <UnifiedDim scale="1" type="RightEdge">
            <DimOperator op="Subtract">
              <ImageDim imageset="component2" image="WindowTopRight" dimension="Width" />
            </DimOperator>
          </UnifiedDim>
        </Dim>
        <Dim type="BottomEdge">
          <UnifiedDim scale="1" type="BottomEdge">
            <DimOperator op="Subtract">
              <ImageDim imageset="component2" image="WindowBottomEdge" dimension="Height" />
            </DimOperator>
          </UnifiedDim>
        </Dim>
      </Area>
    </NamedArea>
    <NamedArea name="ClientNoTitleNoFrame">
      <Area>
        <Dim type="LeftEdge">
          <AbsoluteDim value="0" />
        </Dim>
        <Dim type="TopEdge">
          <AbsoluteDim value="0" />
        </Dim>
        <Dim type="Width">
          <UnifiedDim scale="1" type="Width" />
        </Dim>
        <Dim type="Height">
          <UnifiedDim scale="1" type="Height" />
        </Dim>
      </Area>
    </NamedArea>
    <Child type="TaharezLook/Titlebar" nameSuffix="__auto_titlebar__">
      <Area>
        <Dim type="LeftEdge">
          <UnifiedDim scale="0" offset="50" type="LeftEdge" />
        </Dim>
        <Dim type="TopEdge">
          <AbsoluteDim value="10" />
        </Dim>
        <Dim type="Width">
          <UnifiedDim scale="1" offset="-100" type="Width" />
        </Dim>
        <Dim type="Height">
          <AbsoluteDim value="30" />
        </Dim>
      </Area>
      <Property name="AlwaysOnTop" value="True" />
    </Child>
    <Child type="TaharezLook/ImageButton" nameSuffix="__auto_closebutton__">
      <Area>
        <Dim type="LeftEdge">
          <UnifiedDim scale="1" type="RightEdge">
            <DimOperator op="Subtract">
              <AbsoluteDim value="35" />
            </DimOperator>
          </UnifiedDim>
        </Dim>
        <Dim type="TopEdge">
          <AbsoluteDim value="15" />
        </Dim>
        <Dim type="Width">
          <ImageDim imageset="component" image="CloseButtonNormal" dimension="Width" />
        </Dim>
        <Dim type="Height">
          <ImageDim imageset="component" image="CloseButtonNormal" dimension="Height" />
        </Dim>
      </Area>
      <Property name="AlwaysOnTop" value="True" />
      <Property name="NormalImage" value="set:component2 image:CloseButtonNormal" />
      <Property name="HoverImage" value="set:component2 image:CloseButtonHover" />
      <Property name="PushedImage" value="set:component2 image:CloseButtonPressed" />
    </Child>
    <ImagerySection name="withtitle_frame">
      <FrameComponent>
        <Area>
          <Dim type="LeftEdge">
            <AbsoluteDim value="0" />
          </Dim>
          <Dim type="TopEdge">
            <AbsoluteDim value="0" />
          </Dim>
          <Dim type="Width">
            <UnifiedDim scale="1" type="Width" />
          </Dim>
          <Dim type="Height">
            <UnifiedDim scale="1" type="Height" />
          </Dim>
        </Area>
        <Image type="TopLeftCorner" imageset="component2" image="WindowTopLeft" />
        <Image type="TopRightCorner" imageset="component2" image="WindowTopRight" />
        <Image type="BottomLeftCorner" imageset="component2" image="WindowBottomLeft" />
