        </Dim>
        <Dim type="Height">
          <UnifiedDim scale="1" type="Height" />
        </Dim>
      </Area>
    </NamedArea>
    <Child type="TaharezLook/Titlebar" nameSuffix="__auto_titlebar__">
      <Area>
        <Dim type="LeftEdge">
          <UnifiedDim scale="0" offset="50" type="LeftEdge" />
        </Dim>
        <Dim type="TopEdge">
          <AbsoluteDim value="10" />
        </Dim>
        <Dim type="Width">
          <UnifiedDim scale="1" offset="-100" type="Width" />
        </Dim>
        <Dim type="Height">
          <AbsoluteDim value="30" />
        </Dim>
      </Area>
      <Property name="AlwaysOnTop" value="True" />
    </Child>
    <Child type="TaharezLook/ImageButton" nameSuffix="__auto_closebutton__">
      <Area>
        <Dim type="LeftEdge">
          <UnifiedDim scale="1" type="RightEdge">
            <DimOperator op="Subtract">
              <AbsoluteDim value="35" />
            </DimOperator>
          </UnifiedDim>
        </Dim>
        <Dim type="TopEdge">
          <AbsoluteDim value="10" />
        </Dim>
        <Dim type="Width">
          <ImageDim imageset="component" image="CloseButtonNormal" dimension="Width" />
        </Dim>
        <Dim type="Height">
          <ImageDim imageset="component" image="CloseButtonNormal" dimension="Width" />
        </Dim>
      </Area>
      <Property name="AlwaysOnTop" value="True" />
      <Property name="NormalImage" value="set:component image:CloseButtonNormal" />
      <Property name="HoverImage" value="set:component image:CloseButtonHover" />
      <Property name="PushedImage" value="set:component image:CloseButtonPressed" />
    </Child>
    <ImagerySection name="withtitle_frame">
      <FrameComponent>
        <Area>
          <Dim type="LeftEdge">
            <AbsoluteDim value="0" />
          </Dim>
          <Dim type="TopEdge">
            <AbsoluteDim value="0" />
          </Dim>
          <Dim type="Width">
            <UnifiedDim scale="1" type="Width" />
          </Dim>
          <Dim type="Height">
            <UnifiedDim scale="1" type="Height" />
          </Dim>
        </Area>
        <Image type="TopLeftCorner" imageset="component" image="FrameTopLeft" />
        <Image type="TopRightCorner" imageset="component" image="FrameTopRight" />
        <Image type="BottomLeftCorner" imageset="component" image="FrameBotLeft" />
        <Image type="BottomRightCorner" imageset="component" image="FrameBotRight" />
        <Image type="LeftEdge" imageset="component" image="FrameLeftMiddle" />
        <Image type="RightEdge" imageset="component" image="FrameRightMiddle" />
        <Image type="TopEdge" imageset="component" image="FrameTopMiddle" />
        <Image type="BottomEdge" imageset="component" image="FrameBotMiddle" />
        <Image type="Background" imageset="component" image="FrameMiddle" />
        <VertFormat type="Stretched" />
        <HorzFormat type="Stretched" />
      </FrameComponent>
    </ImagerySection>
    <ImagerySection name="notitle_frame">
      <FrameComponent>
        <Area>
          <Dim type="LeftEdge">
            <AbsoluteDim value="0" />
          </Dim>
          <Dim type="TopEdge">
            <AbsoluteDim value="0" />
          </Dim>
          <Dim type="Width">
            <UnifiedDim scale="1" type="Width" />
          </Dim>
          <Dim type="Height">
            <UnifiedDim scale="1" type="Height" />
          </Dim>
        </Area>
        <Image type="TopLeftCorner" imageset="component" image="FrameTopLeft" />
        <Image type="TopRightCorner" imageset="component" image="FrameTopRight" />
        <Image type="BottomLeftCorner" imageset="component" image="FrameBotLeft" />
        <Image type="BottomRightCorner" imageset="component" image="FrameBotRight" />
        <Image type="LeftEdge" imageset="component" image="FrameLeftMiddle" />
        <Image type="RightEdge" imageset="component" image="FrameRightMiddle" />
        <Image type="BottomEdge" imageset="component" image="FrameBotMiddle" />
      </FrameComponent>
      <ImageryComponent>
        <Area>
          <Dim type="LeftEdge">
            <ImageDim imageset="component" image="WindowTopLeft" dimension="Width" />
          </Dim>
          <Dim type="TopEdge">
            <ImageDim imageset="component" image="WindowTopEdge" dimension="Width" />
          </Dim>
          <Dim type="RightEdge">
            <UnifiedDim scale="1" type="Width">
              <DimOperator op="Subtract">
                <ImageDim imageset="component" image="WindowTopRight" dimension="Width" />
              </DimOperator>
            </UnifiedDim>
          </Dim>
          <Dim type="BottomEdge">
            <UnifiedDim scale="1" type="Height">
              <DimOperator op="Subtract">
                <ImageDim imageset="component" image="WindowBottomEdge" dimension="Height" />
              </DimOperator>
            </UnifiedDim>
          </Dim>
        </Area>
        <Image imageset="component" image="GenericBrush" />
        <ColourProperty name="ClientAreaColour" />
        <VertFormat type="Stretched" />
        <HorzFormat type="Stretched" />
      </ImageryComponent>
    </ImagerySection>
    <ImagerySection name="withtitle_noframe_client_area">
      <ImageryComponent>
        <Area>
          <Dim type="LeftEdge">
            <AbsoluteDim value="0" />
          </Dim>
          <Dim type="TopEdge">
            <WidgetDim widget="__auto_titlebar__" dimension="Height" />
          </Dim>
          <Dim type="Width">
            <UnifiedDim scale="1" type="Width" />
          </Dim>
          <Dim type="BottomEdge">
            <UnifiedDim scale="1" type="BottomEdge" />
          </Dim>
        </Area>
        <Image imageset="component" image="GenericBrush" />
        <ColourProperty name="ClientAreaColour" />
        <VertFormat type="Stretched" />
        <HorzFormat type="Stretched" />
      </ImageryComponent>
    </ImagerySection>
    <ImagerySection name="notitle_noframe_client_area">
      <ImageryComponent>
        <Area>
          <Dim type="LeftEdge">
            <AbsoluteDim value="0" />
          </Dim>
          <Dim type="TopEdge">
            <AbsoluteDim value="0" />
          </Dim>
          <Dim type="Width">
            <UnifiedDim scale="1" type="Width" />
          </Dim>
          <Dim type="Height">
            <UnifiedDim scale="1" type="Height" />
          </Dim>
        </Area>
        <Image imageset="component" image="GenericBrush" />
        <ColourProperty name="ClientAreaColour" />
        <VertFormat type="Stretched" />
        <HorzFormat type="Stretched" />
      </ImageryComponent>
    </ImagerySection>
    <StateImagery name="ActiveWithTitleWithFrame">
      <Layer>
        <Section section="withtitle_frame" />
      </Layer>
    </StateImagery>
    <StateImagery name="InactiveWithTitleWithFrame">
      <Layer>
