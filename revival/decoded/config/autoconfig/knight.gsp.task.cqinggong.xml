<?xml version='1.0' encoding='utf-8'?>
<root>
  <record id="1" item1="50296" action1="jump1" name1="踏波行" des1="一段轻功，心如止水化风轻，波澜不惊点涟漪，凌风踏浪，快意恩仇。" image1="set:MainControl25 image:Q1" item2="50306" action2="jump11" name2="踏水无痕" des2="二段轻功，身如烟波随风去，式照乾坤踏云空，轻若无物，婉若游龙。" image2="set:MainControl25 image:Q1" tailid="50323" tailname="咕嘟泡泡" taildes="轻功拖尾的海洋泡泡效果，所有人可见。" tailimage="set:ItemIcon4 image:1635" taileffect="3d/effect/other/fxo0002_qinggongguiji02" />
  <record id="2" item1="50297" action1="jump2" name1="穿云纵" des1="一段轻功，穿云飞渡随风逝，急如紫电破云出，身型轻巧，进退自如。" image1="set:MainControl25 image:Q2" item2="50307" action2="jump12" name2="扶摇步法" des2="二段轻功，扶摇直上青天里，任凭驭风踏云出，飞身跳跃，腾空而起。" image2="set:MainControl25 image:Q2" tailid="50324" tailname="漫天花雨" taildes="轻功拖尾的花瓣飘散效果，所有人可见。" tailimage="set:ItemIcon4 image:1636" taileffect="3d/effect/other/fxo0002_qinggongguiji03" />
  <record id="3" item1="50298" action1="jump3" name1="燕子跳" des1="一段轻功，身若鸿燕轻如许，跃入丛林难觅踪，双足点地，弹力十足。" image1="set:MainControl25 image:Q3" item2="50308" action2="jump13" name2="凌波微步" des2="二段轻功，休迅飞凫忽若神，凌波微步袜生尘，步法变换，莫测无穷。" image2="set:MainControl25 image:Q3" tailid="50325" tailname="炫色浪漫" taildes="轻功拖尾的浪漫炫光效果，所有人可见。" tailimage="set:ItemIcon4 image:1637" taileffect="3d/effect/other/fxo0002_qinggongguiji04" />
  <record id="4" item1="50299" action1="jump4" name1="雁行功" des1="一段轻功，雁自飞行杳成空，身轻如燕去无踪，身轻如鸿，缓缓而落。" image1="set:MainControl25 image:Q4" item2="50309" action2="jump14" name2="神行无踪" des2="二段轻功，银河九天御风行，迅若日月纵云间，健步如飞，日行千里。" image2="set:MainControl25 image:Q4" tailid="50326" tailname="星知我心" taildes="轻功拖尾的星星效果，所有人可见。" tailimage="set:ItemIcon4 image:1638" taileffect="3d/effect/other/fxo0002_qinggongguiji05" />
  <record id="5" item1="50300" action1="jump5" name1="醉仙步" des1="一段轻功，人生难得几回醉，醉里看花更觉清，醉卧沙场，酒意阑珊。" image1="set:MainControl25 image:Q5" item2="50310" action2="jump15" name2="青莲步法" des2="二段轻功，步法随心画青莲，移身换步似蝶影，蜂蝶息枝，鸿雁难离。" image2="set:MainControl25 image:Q5" tailid="0" tailname="0" taildes="0" tailimage="0" taileffect="0" />
  <record id="6" item1="50301" action1="jump6" name1="草上飞" des1="一段轻功，俯首提气草上飞，迅若惊雷破云间，凌虚踏空，草上飞行。" image1="set:MainControl25 image:Q6" item2="50311" action2="jump16" name2="飘香幻影" des2="二段轻功，移步成影随心欲，露夜飘香影空形，迅若流光，快过闪电。" image2="set:MainControl25 image:Q6" tailid="0" tailname="0" taildes="0" tailimage="0" taileffect="0" />
  <record id="7" item1="50302" action1="jump7" name1="提纵术" des1="一段轻功，蓄力后发纵身跃，如履平地上天梯，空中地下，急掠前行。" image1="set:MainControl25 image:Q7" item2="50312" action2="jump17" name2="一苇渡江" des2="二段轻功，芦苇翩翩淌水过，落英袅袅渡江行，水波荡漾，悉随已意。" image2="set:MainControl25 image:Q7" tailid="0" tailname="0" taildes="0" tailimage="0" taileffect="0" />
  <record id="8" item1="50303" action1="jump8" name1="卧波行" des1="一段轻功，卧波踏浪随已意，如履平地水上行，乘风破浪，任意前行。" image1="set:MainControl25 image:Q8" item2="50313" action2="jump18" name2="彩翼凌空" des2="二段轻功，穿花彩翼深深见，点水蜻蜓款款飞，身形飞落，飘忽不定。" image2="set:MainControl25 image:Q8" tailid="0" tailname="0" taildes="0" tailimage="0" taileffect="0" />
  <record id="9" item1="50304" action1="jump9" name1="水上漂" des1="一段轻功，水波荡漾念念去，轻身跳跃默默飘，水面穿行，如履平地。" image1="set:MainControl25 image:Q9" item2="50314" action2="jump19" name2="天外飞仙" des2="二段轻功，天外有仙随云去，心中无神念情殇，飘逸轻灵，变化万方。" image2="set:MainControl25 image:Q9" tailid="0" tailname="0" taildes="0" tailimage="0" taileffect="0" />
  <record id="10" item1="50305" action1="jump10" name1="五禽术" des1="一段轻功，仿似五禽乾坤定，提身借力退云从，五禽之力，借力得力。" image1="set:MainControl25 image:Q10" item2="50315" action2="jump20" name2="凤凰展翅" des2="二段轻功，凤凰傲意展翅时，百鸟俯首啼鸣日，傲视群雄，天下无敌。" image2="set:MainControl25 image:Q10" tailid="0" tailname="0" taildes="0" tailimage="0" taileffect="0" />
</root>