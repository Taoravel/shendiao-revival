  <record id="12" starttime="2015-02-14 23：59：59" endtime="2015-02-23 23：59：59" showstarttime="2015-02-15" showendtime="2015-02-23" exercisename="拜贺新年" exercisedis="&lt;T t=&quot;【拜贺新年】&quot; c=&quot;ffff3333&quot;&gt;&lt;/T&gt;&lt;B&gt;&lt;/B&gt;&#10;&lt;T t=&quot;活动时间：&quot; c=&quot;ff00ffff&quot;&gt;&lt;/T&gt;&lt;T t=&quot;2015年2月15日至2015年2月23日。&quot;&gt;&lt;/T&gt;&lt;B&gt;&lt;/B&gt;&#10;&lt;T t=&quot;活动描述：&quot; c=&quot;ff00ffff&quot;&gt;&lt;/T&gt;&lt;T t=&quot;春节活动时间内，40级以上玩家可以在杨洋洋处领取一次拜贺新年任务，要求玩家到各大门派以武会友，拜贺新年，拜年成功后会获得长辈们的红包奖励哦。&quot;&gt;&lt;/T&gt;&lt;B&gt;&lt;/B&gt;&#10;&#10;&#10;" hyperlink="&lt;T t=&quot; &quot; c=&quot;ff136e18&quot;&gt;&lt;/T&gt;&lt;B&gt;&lt;/B&gt;&#10;&lt;T t=&quot;    &quot; c=&quot;ff136e18&quot;&gt;&lt;/T&gt;&lt;G t=&quot;杨洋洋&quot; npcid=&quot;13587&quot;&gt;&lt;/G&gt;&#10;" />
