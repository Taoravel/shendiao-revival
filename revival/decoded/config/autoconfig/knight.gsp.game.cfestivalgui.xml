  <record id="9" starttime="2015-12-31 23：59：59" endtime="2016-01-03 23：59：59" showstarttime="2016-01-01" showendtime="2016-01-03" exercisename="新年群英会" exercisedis="&lt;T t=&quot;【新年群英会】&quot; c=&quot;ffff3333&quot;&gt;&lt;/T&gt;&lt;B&gt;&lt;/B&gt;&#10;&lt;T t=&quot;活动时间：&quot; c=&quot;ff00ffff&quot;&gt;&lt;/T&gt;&lt;T t=&quot;2016年01月01日至2016年01月03日。&quot;&gt;&lt;/T&gt;&lt;B&gt;&lt;/B&gt;&#10;&lt;T t=&quot;活动描述：&quot; c=&quot;ff00ffff&quot;&gt;&lt;/T&gt;&lt;T t=&quot;活动时间内，60级以上玩家可以在嘉兴元旦特使处领取新年群英会任务，此任务只可领取一次，放弃也记次数哦。&quot;&gt;&lt;/T&gt;&lt;B&gt;&lt;/B&gt;&#10;&#10;" hyperlink="&lt;T t=&quot; &quot; c=&quot;ff136e18&quot;&gt;&lt;/T&gt;&lt;B&gt;&lt;/B&gt;&#10;&lt;T t=&quot;    &quot; c=&quot;ff136e18&quot;&gt;&lt;/T&gt;&lt;G t=&quot;元旦特使&quot; npcid=&quot;13168&quot;&gt;&lt;/G&gt;&#10;" />
