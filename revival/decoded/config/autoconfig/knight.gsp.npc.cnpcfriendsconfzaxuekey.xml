  <record id="1" npcid="10568" name="周伯通" jianghuname="中顽童 周伯通" brief="外号老顽童，为全真教创始人王重阳师弟，生性纯真，爱作弄人，习武成痴，不拘小节。年少时与段王妃瑛姑有感情，育有一子夭折。王重阳临终把《九阴真经》托付于他，经书却被黄药师骗去，被困桃花岛十五年。最后继承王重阳“中神通”之位，得“中顽童”称号，成为“新五绝”之首。" ShiliStr="百花谷" MingSheng="4" EMing="2" temper="天真烂漫" ShiLi="10" KouCai="0" JiGuan="0" YiShu="0" BingFa="0" JiuLiang="3" YinLv="0" GongJian="3" DiLi="6" NongXue="4" InitQingMiDu="1501" ChouHen="0" LengDai="2000" ZhongLi="4000" YouShan="6000" QingMi="8000" ManZhi="10000" PosDes="&lt;G t=&quot;临安（468,53）&quot; m=&quot;1007&quot; x=&quot;137&quot; y=&quot;209&quot;&gt;&lt;/G&gt;" treatmsg="&lt;T t=&quot;诶？有好吃的哎！老顽童可一定不会错过，小娃儿我太喜欢你了。&quot;&gt;&lt;/T&gt;" jiejiaoduihua="143556" />
