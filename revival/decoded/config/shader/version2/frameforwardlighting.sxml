<?xml version='1.0' encoding='utf-8'?>
<shaderTemplate>
  <shaderFramework name="ForwardLighting">
    <inputDeclaration>
    
		struct VS_INPUT
		{
        float4 Position  : POSITION;
        #ifdef DeclareColor
		    float4 Color     : COLOR; 
        #endif
        #ifdef DeclareNormal
		    float3 Normal    : NORMAL;
        #endif
		    #ifdef DeclareInputUV0 
		    float4 UV0       : TEXCOORD0; 
		    #endif 
		    #ifdef DeclareInputUV1 
		    float4 UV1       :TEXCOORD1; 
		    #endif 
		    #ifdef DeclareInputUV2 
		    float4 UV2       :TEXCOORD2; 
		    #endif 
		    #ifdef DeclareInputUV3 
		    float4 UV3       :TEXCOORD3; 
		    #endif 
		    #ifdef DeclareInputUV4 
		    float4 UV4       :TEXCOORD4; 
		    #endif 
		    #ifdef DeclareInputUV5 
		    float4 UV5       :TEXCOORD5; 
		    #endif 
		    #ifdef DeclareInputUV6 
		    float4 UV6       :TEXCOORD6; 
		    #endif 
		    #ifdef DeclareInputUV7 
		    float4 UV7       :TEXCOORD7; 
		    #endif 
		    #ifdef Declare_USE_Bionormal 
		    float3 Bionormal : BINORMAL; 
		    #endif 
		    #ifdef Declare_USE_Tangent 
		    float3 Tangent	 : TANGENT; 
	      #endif
        #ifdef Declare_BlendIndices
        float4 BoneIndex : BLENDINDICES; //在骨骼调色板中的索引	
        #endif
        #ifdef Declare_BlendWeight
	      float4 BoneWeight: BLENDWEIGHT; //上面按照0-3每个骨骼的权重
        #endif
		};
		

    </inputDeclaration>
    <outputDeclaration>
    
		struct VS_OUTPUT 
		{ 
		    float4 Position  : POSITION;
        #ifdef DeclareNormal
		    float4 Normal        : TEXCOORD7; 
        #endif
        #ifdef DeclareColor
		    float4 Color         : COLOR; 
        #endif
		    #ifdef DeclareOutputUV0 
		    float4 UV0           : TEXCOORD0;
		    #endif 
		    #ifdef DeclareOutputUV1 
		    float4 UV1           : TEXCOORD1; 
		    #endif 
		    #ifdef DeclareOutputUV2 
		    float4 UV2           : TEXCOORD2; 
		    #endif 
		    #ifdef DeclareOutputUV3 
		    float4 UV3           : TEXCOORD3; 
		    #endif 
		    #ifdef DeclareOutputUV4 
		    float4 UV4           : TEXCOORD4; 
		    #endif 
		    #ifdef DeclareOutputUV5 
		    float4 UV5           : TEXCOORD5; 
		    #endif 
		    #ifdef DeclareOutputUV6 
		    float4 UV6           : TEXCOORD6; 
		    #endif 
	    };
		

    </outputDeclaration>
    <pixelOutputDeclaration>
    
	  struct PS_OUTPUT
	  {
	    float4 Color : COLOR;
	  };
	  
    </pixelOutputDeclaration>
    <shaderInfo type="VS">
      <functionEntry>
      
		VS_OUTPUT VS(VS_INPUT input)
		{
		    VS_OUTPUT output = (VS_OUTPUT)0;
	    
      </functionEntry>
      <returnCode>
      
		return output;
		}
	    
      </returnCode>
      <macro name="SS_Vertex_Calculate_LocalPosNormal" />
      <macro name="SS_Vertex_Calculate_WorldPosNormal" />
      <macro name="SS_Vertex_Output_UVTex" />
      <macro name="SS_Vertex_Output_Color" />
      <macro name="SS_Vertex_Output_Normal" />
      <macro name="SS_Vertex_Output_Position" />
      <macro name="SS_Vertex_Output_RealtimeLighting" />
      <macro name="SS_Vertex_Output_ShadowMap" />
      <macro name="SS_Vertex_Output_NormalMap" />
      <macro name="SS_Vertex_Output_Reflection" />
      <macro name="SS_Vertex_Output_Fog" />
      <macro name="SS_Vertex_Output_Terrain" />
      <macro name="SS_Vertex_Output_SelfDefine" />
    </shaderInfo>
    <shaderInfo type="PS">
      <functionEntry>
      
		PS_OUTPUT PS(VS_OUTPUT input)
		{
		PS_OUTPUT output = (PS_OUTPUT)0;
	    
      </functionEntry>
      <returnCode>
      
		return output;
		}
	    
      </returnCode>
      <initCode>
      
	        output.Color = float4(1,1,1,1); //默认输出白色
	    
      </initCode>
      <macro name="SS_Pixel_UV" />
      <macro name="SS_Pixel_Diffuse" />
      <macro name="SS_Pixel_AlphaClip" />
      <macro name="SS_Pixel_Normal" />
      <macro name="SS_Pixel_ShadowMap" />
      <macro name="SS_Pixel_SpecularFactor" />
      <macro name="SS_Pixel_SH_Lighting" />
      <macro name="SS_Pixel_Realtime_Lighting" />
      <macro name="SS_Pixel_LightMap" />
      <macro name="SS_Pixel_Emissive_Blend" />
      <macro name="SS_Pixel_Reflection" />
      <macro name="SS_Pixel_Refraction" />
      <macro name="SS_Pixel_ColorBlend" />
      <macro name="SS_Pixel_ToneMap" />
      <macro name="SS_Pixel_Fog" />
    </shaderInfo>
  </shaderFramework>
</shaderTemplate>